# Cerply V2.0 API Configuration Example
# Copy this to .env and add your real API keys

# Database
DATABASE_URL=postgresql://cerply:cerply@localhost:5432/cerply

# OpenAI API (for drafting with GPT-5)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# Anthropic API (for quality checks with Sonnet 4.5, chat with Haiku 3.5)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-key-here

# V2 Dev Mode (bypasses auth for testing)
V2_DEV_MODE=true

# Model Configuration (optional overrides)
# TOP_MODEL=chatgpt-5-latest                 # Drafting (GPT-5 for best quality)
# QUALITY_MODEL=claude-sonnet-4.5-20250514   # Quality checks (Sonnet 4.5 latest)
# FAST_MODEL=claude-3-5-haiku-20241022       # Chat (Haiku for speed)

# Cost Guardrails
DAILY_ORG_CAP_CENTS=10000  # $100 daily limit per org
DAILY_USER_CAP_CENTS=1000   # $10 daily limit per user

# Server
PORT=8080
NODE_ENV=development
